{
    "scenarios": [
        {
            "id": "family_order",
            "text": "Hello, I want to order dinner for my family",
            "type": "order_initiation",
            "expected_outcomes": [
                "Ask for number of people",
                "Ask for dietary preferences",
                "Suggest family-style options"
            ]
        },
        {
            "id": "order",
            "text": "What do you recommend on your menu",
            "type": "order_specification",
            "expected_outcomes": [
                "Acknowledge order",
                "Suggest toppings"
            ]
        },
        {
            "id": "group_size",
            "text": "Can you put together a meal for 4 people?",
            "type": "order_specification",
            "expected_outcomes": [
                "Acknowledge group size",
                "Suggest appropriate portion sizes",
                "Ask for preferences or restrictions"
            ]
        },
        {
            "id": "drink_order",
            "text": "Include medium size drinks for everyone",
            "type": "order_addition",
            "expected_outcomes": [
                "Confirm drink quantity",
                "List drink options",
                "Ask for specific drink preferences"
            ]
        },
        {
            "id": "order_modification",
            "text": "let me have a cheeseburger. Increase the order by 2 people and give me a summary of the total order",
            "type": "order_modification",
            "expected_outcomes": [
                "Acknowledge order increase",
                "Update quantities",
                "Suggest additional items"
            ]
        },
        {
            "id": "order_request",
            "text": "Can I get a pretzel hamburger with unsalted fries and a medium drink? Make the drink a Coke",
            "type": "order_request",
            "expected_outcomes": [
                "Provide a detailed summary of the order",
                "Confirm all items and quantities",
                "Ask for any final modifications"
            ]
        },
        {
            "id": "repeat_order",
            "text": "I ordered a cheeseburger with unsalted fries and a medium Coke last time, can I get the same? But make it a large Coke this time",
            "type": "repeat_order",
            "expected_outcomes": [
                "Confirm previous order details",
                "Update drink size",
                "Provide a summary of the updated order"
            ]
        },
        {
            "id": "invalid_order",
            "text": "I want a pizza with pineapple and olives as toppings, I am a vegetarian",
            "type": "invalid_order",
            "expected_outcomes": [
                "Acknowledge dietary restriction",
                "Confirm that it is an invalid order",
                "Suggest alternative vegetarian options"
            ]
        }
    ]
}
